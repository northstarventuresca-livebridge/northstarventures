{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northstarventures",
  "compatibility_date": "2026-09-18",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "kv_namespaces": [
    {
      "binding": "INBOX"
    }
  ]
}
