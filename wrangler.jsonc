{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northstarventures",
  "compatibility_date": "2026-09-18",
  "main": "./worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/admin*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "INBOX"
    },
    {
      "binding": "REGISTRY",
      "id": "fc06a487aa0547fd93f14e4ac30de556"
    }
  ],
  "send_email": [
    {
      "name": "BUILD_EMAIL",
      "destination_address": "ryan.wyers@gmail.com"
    },
    {
      "name": "ADMIN_RESET_EMAIL",
      "destination_address": "northstarventures.ca@gmail.com"
    }
  ]
}
